# Copy to .env and fill in. .env is gitignored; this file is not.

# Postgres connection string for the `library` database.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/library

# Exact origin of the frontend. Compared as a string by CORS — scheme, host and port
# all have to match. Vite's dev server is http (not https) on 5173.
CLIENT_URL=http://localhost:5173

# Optional. Defaults to 3000.
PORT=3000
